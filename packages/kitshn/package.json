{
  "name": "kitshn",
  "version": "0.0.0",
  "description": "kitshn recipes: defineApp, the recipe schema, and the CLI that checks and deploys a recipe.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./recipe": "./src/recipe.ts"
  },
  "bin": {
    "kitshn": "./dist/kitshn.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "bun build src/cli.ts --target=node --outfile=dist/kitshn.mjs"
  },
  "dependencies": {
    "@babel/parser": "8.0.8",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
